#!/bin/bash
# One-command release for flat
# Usage: ./release 0.4.0

set -e

VERSION="${1}"

if [ -z "$VERSION" ]; then
  echo "Usage: ./release <version>"
  echo "Example: ./release 0.4.0"
  exit 1
fi

TAG="v${VERSION}"

echo "🚀 Releasing flat ${VERSION}..."

# Quick validation
if ! cargo test --quiet 2>/dev/null; then
  echo "❌ Tests failed"
  exit 1
fi

# Commit everything
git add -A
git commit -m "Release ${VERSION}

Co-Authored-By: Claude Haiku 4.5 <noreply@anthropic.com>" || true

# Tag
git tag -a "${TAG}" -m "Release ${VERSION}"

# Push
git push origin main
git push origin "${TAG}"

echo "✅ Release ${TAG} pushed!"
echo "📦 GitHub Actions building: https://github.com/zkoranges/flat/actions"
echo "🎉 Release page: https://github.com/zkoranges/flat/releases/tag/${TAG}"
